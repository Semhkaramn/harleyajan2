# Telegram API (my.telegram.org)
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxx

# Session String (generate_session.py ile oluşturun)
SESSION_STRING=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Takip edilecek grup ID (negatif sayı)
GROUP_ID=-1001234567890

# Bildirimlerin gönderileceği grup (aynı olabilir)
NOTIFICATION_GROUP_ID=-1001234567890

# Admin ID'leri (virgülle ayırın)
ADMIN_IDS=123456789,987654321

# Kontrol aralığı (dakika)
CHECK_INTERVAL_MINUTES=30

# Neon.tech PostgreSQL URL
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
